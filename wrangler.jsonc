{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.mjs",
	"name": "mubendecountryresort",
	"compatibility_date": "2026-04-20",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mubendecountryresort"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"queues": {
		"producers": [
			{
				"binding": "PAYMENT_RECOVERY_QUEUE",
				"queue": "mcr-payment-recovery"
			}
		],
		"consumers": [
			{
				"queue": "mcr-payment-recovery",
				"max_batch_size": 5,
				"max_batch_timeout": 30,
				"max_retries": 5,
				"retry_delay": 300
			}
		]
	},
	"vars": {
		"PESAPAL_BASE_URL": "https://cybqa.pesapal.com/pesapalv3",
		// Canonical public origin (MCR-SEC-08). Pesapal callback/IPN URLs and
		// metadata routes derive from this, never from the request Host header.
		"SITE_URL": "https://mubendecountryresort.mubendecountryresort.workers.dev",
		// Public Turnstile site key. TURNSTILE_SECRET_KEY must be provided as
		// a matching Cloudflare secret for verification to pass.
		"NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADeEL1RXz6XrC_PX"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}

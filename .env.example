# Canonical public origin. Used for Pesapal callback/IPN URLs (MCR-SEC-08)
# and metadata routes (robots/sitemap). Must be the real public host — the
# booking flow derives payment URLs from it, never from the request Host header.
SITE_URL=https://mubendecountryresort.mubendecountryresort.workers.dev

# Server-side Neon Postgres connection string. Keep this secret.
# Production storefront should use the least-privilege `mcr_storefront_app`
# role created by the admin repo's db/0014_storefront_db_role.sql migration,
# not the Neon owner/admin connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Shared secret used only by the Worker queue consumer when it calls the
# internal payment-recovery route. Set with:
#   wrangler secret put PAYMENT_RECOVERY_QUEUE_SECRET
PAYMENT_RECOVERY_QUEUE_SECRET=

# Cloudflare Turnstile. The site key is public and rendered on /book + /contact.
# The secret key is private and validates tokens server-side. Set production
# secret with:
#   wrangler secret put TURNSTILE_SECRET_KEY
# Local always-pass test keys from Cloudflare:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional backward-compatible public variable (avoid for secrets)
# NEXT_PUBLIC_SITE_URL=https://mubendecountryresort.mubendecountryresort.workers.dev
